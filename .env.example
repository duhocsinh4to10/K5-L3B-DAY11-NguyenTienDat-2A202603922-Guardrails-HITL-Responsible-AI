# Copy this file to .env and fill in your own API keys.
# Keep real credentials in .env; never commit them.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Choose openai or gemini.
RED_TEAM_PROVIDER=gemini

# Required when RED_TEAM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when RED_TEAM_PROVIDER=gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
